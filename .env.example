# Copy to .env (next to docker-compose.yml) and fill in.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback
GOOGLE_SCOPES=openid,profile,email
# Optional, comma-separated extra redirect URIs (e.g. frontend callback page)
GOOGLE_ALLOWED_REDIRECT_URIS=
GOOGLE_AUTO_REGISTER_CANDIDATES=true
ATS_JWT_SECRET=replace-with-a-secret-of-at-least-32-characters
ATS_JWT_ISSUER=ats-auth-service
ATS_ACCESS_TOKEN_TTL_SECONDS=900
ATS_REFRESH_TOKEN_TTL_SECONDS=604800
ATS_DB_PASSWORD=ats
